<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Palabravo.Views"
             x:Class="Palabravo.Views.ChallengesPage"
             Title="Retos">
    <Grid RowDefinitions="*,Auto" MaximumWidthRequest="560">
        <ScrollView x:Name="CaminoScroll">
            <VerticalStackLayout Padding="20,18,20,14" Spacing="16">
                <Grid ColumnDefinitions="48,*,48">
                    <BoxView Color="Transparent" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                        <Label Text="PALABRAVO" Style="{StaticResource Eyebrow}" TextColor="{StaticResource Coral}"
                               FontSize="14" HorizontalTextAlignment="Center" />
                        <Label Text="Camino" FontFamily="LoraSemibold" FontSize="38" HorizontalTextAlignment="Center" />
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                            <Label Text="{Binding RankName}" TextColor="{StaticResource Coral}" FontFamily="OpenSansSemibold" FontSize="16" />
                            <Label Text="•" TextColor="{StaticResource Muted}" FontSize="16" />
                            <Label Text="{Binding RankProgressText}" TextColor="{StaticResource Muted}" FontFamily="OpenSansSemibold" FontSize="16" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    <Button Grid.Column="2" Text="?" FontSize="18" TextColor="{StaticResource Ink}"
                            BackgroundColor="{StaticResource Surface}" BorderColor="{StaticResource Border}"
                            BorderWidth="1" CornerRadius="16" Padding="0" Clicked="OnHelpClicked"
                            SemanticProperties.Description="Abrir instrucciones para jugar" />
                </Grid>

                <Border Style="{StaticResource Card}" Padding="16">
                    <VerticalStackLayout Spacing="13">
                        <Grid ColumnDefinitions="1*,1*,1*" ColumnSpacing="8">
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                                <Label Text="🥇" FontSize="25" />
                                <VerticalStackLayout Spacing="-2" VerticalOptions="Center">
                                    <Label Text="{Binding GoldCount}" FontFamily="OpenSansSemibold" FontSize="18" />
                                    <Label Text="ORO" Style="{StaticResource Eyebrow}" FontSize="9" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="6">
                                <Label Text="🥈" FontSize="25" />
                                <VerticalStackLayout Spacing="-2" VerticalOptions="Center">
                                    <Label Text="{Binding SilverCount}" FontFamily="OpenSansSemibold" FontSize="18" />
                                    <Label Text="PLATA" Style="{StaticResource Eyebrow}" FontSize="9" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="6">
                                <Label Text="🥉" FontSize="25" />
                                <VerticalStackLayout Spacing="-2" VerticalOptions="Center">
                                    <Label Text="{Binding BronzeCount}" FontFamily="OpenSansSemibold" FontSize="18" />
                                    <Label Text="BRONCE" Style="{StaticResource Eyebrow}" FontSize="9" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource Border}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Progreso general" TextColor="{StaticResource Muted}" />
                            <Label Grid.Column="1" Text="{Binding ProgressPercentText}" FontFamily="OpenSansSemibold" />
                        </Grid>
                        <ProgressBar Progress="{Binding GeneralProgress}" ProgressColor="{StaticResource Coral}"
                                     BackgroundColor="{StaticResource Border}" HeightRequest="8" />
                        <Label Text="{Binding RankCaption}" TextColor="{StaticResource Coral}" FontSize="12" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout x:Name="RankSectionsHost" BindableLayout.ItemsSource="{Binding RankSections}" Spacing="20">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Spacing="8" Opacity="{Binding Opacity}">
                                <Border BackgroundColor="{Binding SoftColor}" Stroke="{Binding AccentColor}" StrokeThickness="1" Padding="14,10">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Label Text="{Binding Icon}" FontSize="26" TextColor="{Binding AccentColor}" VerticalTextAlignment="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" FontFamily="LoraSemibold" FontSize="21" TextColor="{Binding AccentColor}" />
                                            <Label Text="{Binding StatusText}" FontSize="10" TextColor="{StaticResource Muted}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding ProgressText}" FontFamily="OpenSansSemibold" FontSize="15"
                                               TextColor="{Binding AccentColor}" VerticalTextAlignment="Center" />
                                    </Grid>
                                </Border>

                                <Grid HeightRequest="650">
                                    <views:RankPathView Section="{Binding .}" InputTransparent="True" />
                                    <AbsoluteLayout BindableLayout.ItemsSource="{Binding Nodes}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <VerticalStackLayout AbsoluteLayout.LayoutBounds="{Binding LayoutBounds}"
                                                                     AbsoluteLayout.LayoutFlags="PositionProportional"
                                                                     Spacing="3" Opacity="{Binding Opacity}"
                                                                     SemanticProperties.Description="{Binding SemanticDescription}">
                                                    <Border HeightRequest="74" WidthRequest="74" Padding="0" HorizontalOptions="Center"
                                                            BackgroundColor="{Binding NodeColor}" Stroke="{Binding BorderColor}"
                                                            StrokeThickness="{Binding BorderThickness}">
                                                        <Border.StrokeShape><RoundRectangle CornerRadius="37" /></Border.StrokeShape>
                                                        <VerticalStackLayout Spacing="-3" VerticalOptions="Center">
                                                            <Label Text="{Binding Number}" FontFamily="LoraSemibold" FontSize="22"
                                                                   TextColor="{Binding NumberColor}" HorizontalTextAlignment="Center" />
                                                            <Label Text="{Binding Icon}" FontSize="14" HorizontalTextAlignment="Center" />
                                                        </VerticalStackLayout>
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.PlayCommand}"
                                                                                  CommandParameter="{Binding .}" />
                                                        </Border.GestureRecognizers>
                                                    </Border>
                                                    <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="9"
                                                           HorizontalTextAlignment="Center" MaxLines="2" LineBreakMode="TailTruncation" />
                                                    <Label Text="{Binding StateText}" FontSize="9" TextColor="{Binding BorderColor}"
                                                           HorizontalTextAlignment="Center" MaxLines="1" />
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </AbsoluteLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" BackgroundColor="{StaticResource Cream}" Stroke="Transparent" Padding="20,10,20,12">
            <Button Text="{Binding ContinueText}" Command="{Binding ContinueCommand}" />
        </Border>
    </Grid>
</ContentPage>
