<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Palabravo.Views.TutorialPage"
             Shell.TabBarIsVisible="False"
             Title="Cómo jugar">
    <Grid RowDefinitions="Auto,*" MaximumWidthRequest="560">
        <Grid Padding="16,14,16,8" ColumnDefinitions="48,*" HeightRequest="70">
            <Button Text="‹" FontSize="31" TextColor="{StaticResource Ink}"
                    BackgroundColor="{StaticResource Surface}" BorderColor="{StaticResource Border}"
                    BorderWidth="1" CornerRadius="16" Padding="0" Clicked="OnBackClicked"
                    SemanticProperties.Description="Volver al reto" />
            <Label Grid.Column="1" Text="Cómo jugar" FontFamily="OpenSansSemibold" FontSize="18"
                   VerticalTextAlignment="Center" Margin="14,0,0,0" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,8,20,28" Spacing="18">
                <VerticalStackLayout Spacing="7">
                    <Label Text="Encuentra la conexión" Style="{StaticResource EditorialTitle}" />
                    <Label Text="Las 16 palabras esconden cuatro grupos. Cada grupo contiene exactamente cuatro palabras relacionadas."
                           FontSize="14" TextColor="{StaticResource Muted}" />
                </VerticalStackLayout>

                <Border Style="{StaticResource Card}" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="34,*" ColumnSpacing="10">
                            <Border HeightRequest="30" WidthRequest="30" BackgroundColor="{StaticResource Coral}" Stroke="Transparent">
                                <Border.StrokeShape><RoundRectangle CornerRadius="15" /></Border.StrokeShape>
                                <Label Text="1" TextColor="White" FontFamily="OpenSansSemibold"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Busca algo en común" FontFamily="OpenSansSemibold" FontSize="16" />
                                <Label Text="En este ejemplo, elige las cuatro palabras que son colores."
                                       FontSize="12" TextColor="{StaticResource Muted}" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid RowDefinitions="58,58" ColumnDefinitions="1*,1*,1*,1*" RowSpacing="6" ColumnSpacing="6">
                            <Border BackgroundColor="{StaticResource Coral}" Stroke="{StaticResource Coral}">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Label Text="ROJO" TextColor="White" FontFamily="OpenSansSemibold" FontSize="10"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Border}">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Label Text="MANZANA" FontFamily="OpenSansSemibold" FontSize="9"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <Border Grid.Column="2" BackgroundColor="{StaticResource Coral}" Stroke="{StaticResource Coral}">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Label Text="AZUL" TextColor="White" FontFamily="OpenSansSemibold" FontSize="10"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <Border Grid.Column="3" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Border}">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Label Text="PERA" FontFamily="OpenSansSemibold" FontSize="10"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <Border Grid.Row="1" BackgroundColor="{StaticResource Coral}" Stroke="{StaticResource Coral}">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Label Text="VERDE" TextColor="White" FontFamily="OpenSansSemibold" FontSize="10"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Border}">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Label Text="UVA" FontFamily="OpenSansSemibold" FontSize="10"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" BackgroundColor="{StaticResource Coral}" Stroke="{StaticResource Coral}">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Label Text="AMARILLO" TextColor="White" FontFamily="OpenSansSemibold" FontSize="9"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <Border Grid.Row="1" Grid.Column="3" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Border}">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Label Text="MANGO" FontFamily="OpenSansSemibold" FontSize="10"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="34,*" ColumnSpacing="10">
                    <Border HeightRequest="30" WidthRequest="30" BackgroundColor="{StaticResource Mustard}" Stroke="Transparent">
                        <Border.StrokeShape><RoundRectangle CornerRadius="15" /></Border.StrokeShape>
                        <Label Text="2" TextColor="{StaticResource Ink}" FontFamily="OpenSansSemibold"
                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                        <Label Text="Comprueba el grupo" FontFamily="OpenSansSemibold" FontSize="16" />
                        <Label Text="Cuando selecciones cuatro, toca «Comprobar grupo». Puedes tocar una palabra otra vez para quitarla."
                               FontSize="12" TextColor="{StaticResource Muted}" />
                    </VerticalStackLayout>
                </Grid>

                <Border BackgroundColor="#DDEFE9" Stroke="Transparent" Padding="14,10">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="COLORES" FontFamily="OpenSansSemibold" HorizontalTextAlignment="Center" />
                        <Label Text="ROJO · AZUL · VERDE · AMARILLO" FontSize="10"
                               TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="34,*" ColumnSpacing="10">
                    <Border HeightRequest="30" WidthRequest="30" BackgroundColor="{StaticResource Sage}" Stroke="Transparent">
                        <Border.StrokeShape><RoundRectangle CornerRadius="15" /></Border.StrokeShape>
                        <Label Text="3" TextColor="White" FontFamily="OpenSansSemibold"
                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                        <Label Text="Completa los cuatro grupos" FontFamily="OpenSansSemibold" FontSize="16" />
                        <Label Text="Un acierto se convierte en una banda y sale de la cuadrícula. Resuelve las cuatro conexiones antes de cometer tres errores."
                               FontSize="12" TextColor="{StaticResource Muted}" />
                    </VerticalStackLayout>
                </Grid>

                <Border Style="{StaticResource Card}" Padding="14">
                    <Grid ColumnDefinitions="1*,1*" ColumnSpacing="14">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="● ● ●" TextColor="{StaticResource Coral}" CharacterSpacing="2" FontSize="17" />
                            <Label Text="Tienes 3 intentos" FontFamily="OpenSansSemibold" FontSize="12" />
                            <Label Text="Un grupo incorrecto consume uno." FontSize="11" TextColor="{StaticResource Muted}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="💡  2 pistas" FontSize="16" />
                            <Label Text="Ayudas disponibles" FontFamily="OpenSansSemibold" FontSize="12" />
                            <Label Text="También puedes revelar la solución y terminar." FontSize="11" TextColor="{StaticResource Muted}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border BackgroundColor="#FFF0C8" Stroke="Transparent" Padding="14">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                    <Label Text="Consejo: algunas palabras parecen encajar en más de un grupo. Si una combinación falla, busca una conexión más precisa."
                           FontSize="12" TextColor="{StaticResource Ink}" />
                </Border>

                <Button Text="Entendido, jugar" Clicked="OnBackClicked" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
