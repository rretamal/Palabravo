<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Palabravo.Views.GamePage"
             Shell.TabBarIsVisible="False">
    <Grid Padding="16,14,16,18" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12" MaximumWidthRequest="600">
        <Grid ColumnDefinitions="48,*,48" HeightRequest="48">
            <Button Text="‹" FontSize="31" TextColor="{StaticResource Ink}" BackgroundColor="{StaticResource Surface}" BorderColor="{StaticResource Border}" BorderWidth="1" CornerRadius="16" Padding="0" Clicked="OnBackClicked" />
            <VerticalStackLayout Grid.Column="1" Spacing="0" HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="17" HorizontalTextAlignment="Center" />
                <Label Text="{Binding Subtitle}" FontSize="11" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
            <Button Grid.Column="2" Text="ⓘ" FontSize="20" TextColor="{StaticResource Ink}"
                    BackgroundColor="{StaticResource Surface}" BorderColor="{StaticResource Border}"
                    BorderWidth="1" CornerRadius="16" Padding="0" Clicked="OnHelpClicked"
                    SemanticProperties.Description="Abrir instrucciones para jugar" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <VerticalStackLayout Spacing="1">
                    <Label Text="INTENTOS" Style="{StaticResource Eyebrow}" />
                    <Label Text="{Binding AttemptDots}" FontSize="18" CharacterSpacing="3" TextColor="{StaticResource Coral}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="1">
                    <Label Text="ERRORES" Style="{StaticResource Eyebrow}" HorizontalTextAlignment="End" />
                    <Label Text="{Binding ErrorText}" FontFamily="OpenSansSemibold" FontSize="18" TextColor="{StaticResource Success}" HorizontalTextAlignment="End" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <VerticalStackLayout Grid.Row="2" Spacing="7">
            <Label Text="Cuatro grupos.&#10;Dieciséis palabras." Style="{StaticResource EditorialTitle}" />
            <Label Text="Encuentra cuatro conjuntos de cuatro palabras relacionadas." TextColor="{StaticResource Muted}" FontSize="13" />
            <VerticalStackLayout x:Name="SolvedGroupsPanel" BindableLayout.ItemsSource="{Binding SolvedGroups}" Spacing="6">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{Binding BackgroundColor}" Stroke="Transparent" Padding="12,8">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="1">
                                <Label Text="{Binding Category}" FontFamily="OpenSansSemibold" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding Words}" FontSize="10" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <CollectionView x:Name="WordsCollection" Grid.Row="3" ItemsSource="{Binding Words}" SelectionMode="None" VerticalOptions="Fill">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="4" VerticalItemSpacing="6" HorizontalItemSpacing="6" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="{Binding BackgroundColor}" Stroke="{StaticResource Border}" StrokeThickness="1" MinimumHeightRequest="64" Padding="4" Margin="0,1">
                        <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleWordCommand}" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Word}" TextColor="{Binding TextColor}" FontFamily="OpenSansSemibold"
                               FontSize="{Binding FontSize}" FontAutoScalingEnabled="False" MaxLines="1" LineBreakMode="NoWrap"
                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                               SemanticProperties.Description="{Binding Word}" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="4" Spacing="9">
            <Button Text="Comprobar grupo" Command="{Binding SubmitCommand}" IsEnabled="{Binding CanSubmit}" />
            <Grid ColumnDefinitions="80,*,80" ColumnSpacing="10">
                <Button Text="💡" Command="{Binding HintCommand}" BackgroundColor="{StaticResource Surface}" TextColor="{StaticResource Ink}" BorderColor="{StaticResource Border}" BorderWidth="1" />
                <Label Grid.Column="1" Text="{Binding StatusMessage}" TextColor="{StaticResource Muted}" FontSize="12" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" MaxLines="2" />
                <Button Grid.Column="2" Text="↝" Command="{Binding ShuffleCommand}" BackgroundColor="{StaticResource Surface}" TextColor="{StaticResource Ink}" BorderColor="{StaticResource Border}" BorderWidth="1" FontSize="22" />
            </Grid>
            <Label Text="{Binding HintText}" FontSize="10" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
