<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Palabravo.Views.GamePage"
             Shell.TabBarIsVisible="False">
    <Grid Padding="16,14,16,18" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12" MaximumWidthRequest="600">
        <Grid ColumnDefinitions="48,*,48" HeightRequest="48">
            <Button Text="‹" FontSize="31" TextColor="{StaticResource Ink}" BackgroundColor="{StaticResource Surface}" BorderColor="{StaticResource Border}" BorderWidth="1" CornerRadius="16" Padding="0" Clicked="OnBackClicked" />
            <VerticalStackLayout Grid.Column="1" Spacing="0" HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="17" HorizontalTextAlignment="Center" />
                <Label Text="{Binding Subtitle}" FontSize="11" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
            <Button Grid.Column="2" Text="ⓘ" FontSize="20" TextColor="{StaticResource Ink}"
                    BackgroundColor="{StaticResource Surface}" BorderColor="{StaticResource Border}"
                    BorderWidth="1" CornerRadius="16" Padding="0" Clicked="OnHelpClicked"
                    SemanticProperties.Description="Abrir instrucciones para jugar" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <VerticalStackLayout Spacing="1">
                    <Label Text="{Binding HeaderCaption}" Style="{StaticResource Eyebrow}" />
                    <Label Text="{Binding AttemptDots}" FontSize="18" CharacterSpacing="3" TextColor="{StaticResource Coral}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="1">
                    <Label Text="ERRORES" Style="{StaticResource Eyebrow}" HorizontalTextAlignment="End" />
                    <Label Text="{Binding ErrorText}" FontFamily="OpenSansSemibold" FontSize="18" TextColor="{StaticResource Success}" HorizontalTextAlignment="End" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <VerticalStackLayout Grid.Row="2" Spacing="7" IsVisible="{Binding IsConnectionsVisible}">
            <Label Text="{Binding ConnectionsEyebrow}" Style="{StaticResource Eyebrow}" TextColor="{StaticResource Coral}" />
            <Label Text="Descubre las conexiones" Style="{StaticResource EditorialTitle}" />
            <Label Text="{Binding Instructions}" TextColor="{StaticResource Muted}" FontSize="13" />
            <VerticalStackLayout x:Name="SolvedGroupsPanel" BindableLayout.ItemsSource="{Binding SolvedGroups}" Spacing="6">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{Binding BackgroundColor}" Stroke="Transparent" Padding="12,8">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="1">
                                <Label Text="{Binding Category}" FontFamily="OpenSansSemibold" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding Words}" FontSize="10" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding Explanation}" FontSize="12" TextColor="{StaticResource Ink}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <CollectionView x:Name="WordsCollection" Grid.Row="3" ItemsSource="{Binding Words}" SelectionMode="None" VerticalOptions="Fill" IsVisible="{Binding IsConnectionsVisible}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="4" VerticalItemSpacing="6" HorizontalItemSpacing="6" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="{Binding BackgroundColor}" Stroke="{StaticResource Border}" StrokeThickness="1" MinimumHeightRequest="64" Padding="4" Margin="0,1">
                        <Border.StrokeShape><RoundRectangle CornerRadius="19" /></Border.StrokeShape>
                        <Border.Shadow><Shadow Brush="#18000000" Offset="0,2" Radius="5" Opacity="0.16" /></Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleWordCommand}" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Word}" TextColor="{Binding TextColor}" FontFamily="OpenSansSemibold"
                               FontSize="{Binding FontSize}" FontAutoScalingEnabled="False" MaxLines="1" LineBreakMode="NoWrap"
                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                               SemanticProperties.Description="{Binding Word}" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="4" Spacing="9" IsVisible="{Binding IsConnectionsVisible}">
            <Button Text="Comprobar grupo" Command="{Binding SubmitCommand}" IsEnabled="{Binding CanSubmit}" />
            <Grid ColumnDefinitions="80,*,80" ColumnSpacing="10">
                <Button Text="💡" Command="{Binding HintCommand}" BackgroundColor="{StaticResource Surface}" TextColor="{StaticResource Ink}" BorderColor="{StaticResource Border}" BorderWidth="1" />
                <Label Grid.Column="1" Text="{Binding StatusMessage}" TextColor="{StaticResource Muted}" FontSize="12" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" MaxLines="2" />
                <Button Grid.Column="2" Text="↝" Command="{Binding ShuffleCommand}" BackgroundColor="{StaticResource Surface}" TextColor="{StaticResource Ink}" BorderColor="{StaticResource Border}" BorderWidth="1" FontSize="22" />
            </Grid>
            <Label Text="{Binding HintText}" FontSize="10" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <Border Grid.Row="2" Grid.RowSpan="3" IsVisible="{Binding IsWeeklyQuizVisible}"
                Style="{StaticResource Card}" Padding="22" VerticalOptions="Fill">
            <ScrollView>
            <VerticalStackLayout Spacing="16">
                <Label Text="{Binding HeaderCaption}" Style="{StaticResource Eyebrow}" TextColor="{StaticResource Coral}" HorizontalTextAlignment="Center" />
                <Label Text="{Binding QuizProgress}" FontSize="12" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                <Border IsVisible="{Binding HasQuizImage}" Stroke="{StaticResource Border}" StrokeThickness="1"
                        HeightRequest="190" Padding="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                    <Image Source="{Binding QuizImageSource}" Aspect="AspectFill"
                           SemanticProperties.Description="Imagen para reconocer en la pregunta cultural" />
                </Border>
                <Label Text="{Binding QuizPrompt}" Style="{StaticResource EditorialTitle}" FontSize="25" HorizontalTextAlignment="Center" />
                <VerticalStackLayout IsVisible="{Binding IsWrittenAnswer}" Spacing="12">
                    <Label Text="Piénsalo… ¿qué palabra completa la frase?" FontSize="13" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                    <Entry Text="{Binding WrittenAnswer}" Placeholder="Escribe un adjetivo" MaxLength="80"
                           IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" ReturnType="Done"
                           ReturnCommand="{Binding CheckWrittenAnswerCommand}" SemanticProperties.Description="Tu respuesta, sin alternativas" />
                    <Button Text="Comprobar palabra" Command="{Binding CheckWrittenAnswerCommand}" />
                </VerticalStackLayout>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding QuizOptions}" Spacing="9">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Button Text="{Binding Text}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectQuizAnswerCommand}"
                                    CommandParameter="{Binding .}" BackgroundColor="{StaticResource Surface}"
                                    TextColor="{StaticResource Ink}" BorderColor="{StaticResource Coral}" BorderWidth="1" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Label Text="{Binding QuizFeedback}" FontSize="12" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                <Label Text="{Binding AssembledPieces}" IsVisible="{Binding IsPieces}" HorizontalTextAlignment="Center" />
                <Button Text="Combinar piezas" Command="{Binding CheckPiecesCommand}" IsVisible="{Binding IsPieces}" />
                <Button Text="Ayudas" Command="{Binding HintCommand}" BackgroundColor="Transparent" TextColor="{StaticResource Coral}" />
            </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>
